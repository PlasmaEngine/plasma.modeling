// plasma.modeling — in-editor modeling & blockout toolset.
//
// The AUTHORED manifest, kept in source next to the plugin. It declares identity, compatibility,
// what to load and what to ship. Component hashes and sizes are NOT here: the packaging step
// computes those and emits them into the published manifest that ships inside the .plpkg.
//
// Plans: PlasmaEngine2/Documentation/modeling-blockout-plan.html (design) and
// PlasmaEngine2/Documentation/modeling-production-plan.html (road to 1.0).

PackageInfo
{
	// ---- identity -------------------------------------------------------------
	// 0.x until the release gates of the road-to-1.0 plan (performance budgets,
	// manual pages, release notes) pass; then 1.0.0.
	string %Id{"plasma.modeling"}
	string %Version{"0.3.0"}
	string %Publisher{"PlasmaTechnology"}
	string %License{"MIT"}
	string %Homepage{"https://plasmagameengine.com"}

	// ---- compatibility --------------------------------------------------------
	string %MinEngineVersion{"0.12.0"}
	string %MaxEngineVersion{"0.12.0"}
	string %AbiTag{"win64-msvc19-0.12.0-abi7-dev"}

	// ---- presentation ---------------------------------------------------------
	string %DisplayName{"Modeling"}
	string %Category{"Tools"}
	string %Description{"In-editor level modeling. Draw brushes (box, ramp, column, stairs, arch, spiral) directly in the level with the Brush tool, edit their vertices, edges and faces with polygon operations, carve doorways and windows with live cutters, and give every face its own material and texture projection. The geometry renders, collides, occludes and bakes into the navmesh with no asset files involved, and scene export merges it into optimised meshes.

Also converts Grey Boxing shapes and meshes into brushes, exports to OBJ, bakes brushes into mesh assets, and exposes its tools to MCP clients when plasma.mcp is installed."}
	string %Icon{"Branding/ModelingIcon.png"}
	string %Banner{"Branding/ModelingBanner.png"}

	// ---- binaries -------------------------------------------------------------
	// The runtime (mesh core, generators, brush component - the only module a
	// shipped game needs), the editor UI, and the engine-process plugin that bakes
	// brush CSG at scene export.
	string %EditorPlugins{"plEditorPluginModeling"}
	string %EditorEnginePlugins{"plEnginePluginModeling"}
	string %RuntimePlugins{"plModelingPlugin"}
	string %PackageDependencies{}

	// ---- assets ---------------------------------------------------------------
	// Mounted as a data directory when the package is installed: the viewport shape icons of the
	// brush and brush group components (Editor/ShapeIcons/<type>.dds).
	Mount { string %Path{"Assets"} string %RootName{"plasma.modeling"} bool %Writable{false} }

	// ---- components -----------------------------------------------------------
	Component { string %Name{"assets"} string %Platform{"any"} }
	Component { string %Name{"manifest"} string %Platform{"any"} }
	Component { string %Name{"runtime-win64"} string %Platform{"win64"} }
	Component { string %Name{"runtime-linux64"} string %Platform{"linux64"} string %AbiTag{"linux64-clang18-0.12.0-abi7-dev"} }
	Component { string %Name{"runtime-macos64"} string %Platform{"macos64"} string %AbiTag{"macosarm64-clang17-0.12.0-abi7-dev"} }
	Component { string %Name{"editor-win64"} string %Platform{"win64"} string %Path{"Bin/Windows_x64_Development/plEditorPluginModelingMcp.dll"} }
	Component { string %Name{"icon"} string %Platform{"any"} }
	Component { string %Name{"banner"} string %Platform{"any"} }
	// The editor plugin's icons, found under their ids (":/ModelingIcons/Tools/ModeFace.svg") in EditorIcons.
	Component { string %Name{"tool"} string %Platform{"any"} string %Path{"EditorIcons"} }
}
